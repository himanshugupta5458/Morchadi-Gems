# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Draft A content pipeline working files (ADR-051, narrowed by ADR-057). Unpublished and
# unconfirmed product data in incoming/ and drafts/ stays untracked, treated like .env.local
# rather than like source. completed/ is tracked in full: it holds only the provenance bundles
# (draft + raw block + source images) behind products already published, which enter git at the
# moment of publish. Git will not descend into an ignored *directory*, which is why contents are
# ignored rather than the directories themselves — the untracked folders keep their README.md
# tracked so a fresh clone gets the structure.
/content-pipeline/*
!/content-pipeline/README.md
!/content-pipeline/drafts/
!/content-pipeline/completed/
!/content-pipeline/incoming/
/content-pipeline/drafts/*
!/content-pipeline/drafts/README.md
/content-pipeline/incoming/*
!/content-pipeline/incoming/README.md
!/content-pipeline/pending-review/
/content-pipeline/pending-review/**/*.webp
Latest.xlsx
