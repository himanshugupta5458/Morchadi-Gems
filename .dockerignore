# Keep the build context lean. Everything `next build` needs is NOT listed here:
# app/ components/ lib/ data/ config/ types/ public/ prisma/ package*.json next.config.mjs
# tsconfig.json tailwind.config.ts postcss.config.mjs .eslintrc.json
#
# prisma/ is on that list because the builder runs `prisma generate` before `next build`, and
# generate reads prisma/schema.prisma. Ignoring prisma/ here breaks the build. See ADR-047.

# installed inside the image
node_modules
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# build output — always rebuilt in the builder stage, never copied in
.next
out
build
*.tsbuildinfo

# secrets must never enter the build context or the image
.env
.env.*

# version control and editor state
.git
.gitignore
.github
.vscode
.idea
.claude

# Most of scripts/ is dev-only pipeline and migration tooling, genuinely not read by the
# production build. The negations below are the exceptions: each is a real runtime import from
# lib/, so it must reach the build context even though the rest of this directory should not.
# Without them, `next build` fails type-checking with "Cannot find module '@/scripts/…'" inside
# Docker while passing on a real filesystem, where .dockerignore never applies.
#
#   keyword-normalisation.mjs   imported by lib/keyword-collision-check.ts (e493e4c gave the
#                               keyword rules one implementation, shared between the .ts module
#                               and scripts/validate-products.mjs)
#   product-record-rules.mjs    imported by lib/product-validation.ts — the catalogue's own
#                               validation rules, shared between the gate and the admin product
#                               editor so an edit cannot pass a weaker check than the build's
#                               (ADR-064). It pulls in the two rule modules below.
#   banned-meta-adjectives.mjs  imported by product-record-rules.mjs
#   min-prepaid-rule.mjs        imported by product-record-rules.mjs
#   backfill-keyword-map.mjs    imported by lib/product-repository.ts, which rebuilds
#                               data/keyword-map.json whenever it writes the catalogue
docs
scripts
!scripts/keyword-normalisation.mjs
!scripts/product-record-rules.mjs
!scripts/banned-meta-adjectives.mjs
!scripts/min-prepaid-rule.mjs
!scripts/backfill-keyword-map.mjs

# the Draft A pipeline: 124 MB of source drafts, staged photographs and completed records.
# Nothing in app/, lib/, components/ or config/ imports it, and the runner stage copies only
# public/, .next/standalone and .next/static, so it is build-context weight and nothing else.
content-pipeline
coverage
**/*.test.ts
**/*.test.tsx
vitest.config.mts
Dockerfile
.dockerignore
DEPLOY.md
README.md
CLAUDE.md

# platform leftovers
.vercel
.DS_Store
