// The Phase 2 order and CRM domain — see docs/decisions/ADR-040-postgres-for-orders.md.
//
// The product catalogue is NOT here. It stays in data/products.json, in git, per an explicit
// owner decision recorded in ADR-040. An order row records the price and the cost that applied
// when it was placed; it is never the source consulted to decide what something costs.
//
// Naming convention for this file: Prisma models and fields are PascalCase and camelCase, and
// every one of them is @map'd to the snake_case table and column name ADR-040 uses when it
// talks about this schema in prose. TypeScript reads camelCase, psql reads snake_case, and
// neither has to learn the other's spelling.
//
// Money is Decimal(10, 2) rather than Float. Rupee amounts are exact and a binary float is not.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Where an order currently is. The terminal states — rto, returned, cancelled — are mutually
/// exclusive by construction, which is why no boolean mirrors them. See ADR-040.
enum OrderStatus {
  placed
  packed
  shipped
  delivered
  rto
  returned
  cancelled

  @@map("order_status")
}

/// How the money for an order arrives. Every order captured through today's checkout is
/// `prepaid` — the storefront offers no other choice, and this enum does not add one. It exists
/// so the *schema* can already describe an order taken over WhatsApp or created by an operator,
/// which is the shape the RTO problem of ADR-040 will eventually be answered in. See ADR-042.
enum PaymentType {
  prepaid
  cod
  partial_cod

  @@map("payment_type")
}

model Order {
  /// A 10-character unambiguous alphanumeric code, generated in application code at capture
  /// time. Deliberately not a uuid and deliberately without a database default: it is read
  /// aloud over WhatsApp and typed into a tracking box, so it is ours to shape, not Postgres'.
  id                    String               @id
  createdAt             DateTime             @default(now()) @map("created_at")
  updatedAt             DateTime             @updatedAt @map("updated_at")
  customerId            String               @map("customer_id")
  customer              Customer             @relation(fields: [customerId], references: [id])
  status                OrderStatus          @default(placed)
  subtotal              Decimal              @db.Decimal(10, 2)
  shippingFee           Decimal              @map("shipping_fee") @db.Decimal(10, 2)
  total                 Decimal              @db.Decimal(10, 2)
  /// Sum of the line items' unitCost × quantity, snapshotted at capture time so profit stays
  /// answerable after the catalogue's cost figures move.
  totalCost             Decimal              @map("total_cost") @db.Decimal(10, 2)
  paymentType           PaymentType          @default(prepaid) @map("payment_type")
  /// What was actually collected before dispatch, and what is still owed on delivery. For a
  /// prepaid order these are `total` and `0`; the invariant `amountPrepaid + amountDue = total`
  /// holds for all three payment types, which is what makes "money outstanding" one query
  /// rather than three cases. No default on `amountPrepaid`: a row that forgot to say what was
  /// collected should fail to insert rather than quietly claim nothing was.
  amountPrepaid         Decimal              @map("amount_prepaid") @db.Decimal(10, 2)
  amountDue             Decimal              @default(0) @map("amount_due") @db.Decimal(10, 2)
  /// Set by an operator when the courier's cash-on-delivery remittance is reconciled. Both stay
  /// at their defaults for every prepaid order and no checkout path writes them.
  codAmountCollected    Boolean              @default(false) @map("cod_amount_collected")
  codCollectedAt        DateTime?            @map("cod_collected_at")
  /// Whether the goods came back on an RTO or a return, and when they were physically received.
  /// Distinct from `status = 'rto'`, which says the courier turned the parcel around: the parcel
  /// being back on the shelf is a separate later fact, and it is the one a refund waits on.
  itemReceivedBack      Boolean              @default(false) @map("item_received_back")
  itemReceivedBackAt    DateTime?            @map("item_received_back_at")
  /// Unique, not merely indexed. Cashfree mints one payment order per checkout and this column
  /// is the join between their record and ours, so it is also the key `/api/verify-order` looks
  /// an order up by. A duplicate here would mean two of our orders claiming one payment.
  cashfreeOrderId       String               @unique @map("cashfree_order_id")
  cashfreePaymentStatus String               @map("cashfree_payment_status")
  utmSource             String?              @map("utm_source")
  utmMedium             String?              @map("utm_medium")
  utmCampaign           String?              @map("utm_campaign")
  shippingAddress       Json                 @map("shipping_address")
  /// A note the shopper typed at the payment step, for whoever packs the parcel. Free text from
  /// a browser and treated as such: it is sanitised and truncated by `parseGiftMessage` before
  /// it reaches this column, it is rendered read-only on the admin order detail, and no amount
  /// on this row has ever been computed from it. The length cap is repeated here as a
  /// VARCHAR(300) so the database refuses what the application layer is supposed to have
  /// already trimmed. Null on every order placed without one, and on every order placed before
  /// the field existed.
  giftMessage           String?              @map("gift_message") @db.VarChar(300)
  /// A refund is orthogonal to which terminal status was reached — an order can be returned
  /// and refunded, returned and not refunded, or refunded without having been returned at all.
  /// That is why these three survive where the terminal-state booleans did not. See ADR-040.
  isRefunded            Boolean              @default(false) @map("is_refunded")
  refundedAt            DateTime?            @map("refunded_at")
  refundAmount          Decimal?             @map("refund_amount") @db.Decimal(10, 2)
  lineItems             OrderLineItem[]
  statusHistory         OrderStatusHistory[]

  @@index([customerId])
  @@index([status])
  @@index([createdAt])
  @@map("orders")
}

/// The append-only audit of who moved an order where, and when. This table is the only record
/// of when a status was reached and why, which is why Order carries no rtoAt, returnedAt or
/// cancelledAt of its own.
model OrderStatusHistory {
  id        String      @id @default(uuid())
  orderId   String      @map("order_id")
  order     Order       @relation(fields: [orderId], references: [id])
  status    OrderStatus
  changedAt DateTime    @default(now()) @map("changed_at")
  /// The admin who made the change. A free string rather than a foreign key to Admin, so the
  /// audit survives an operator being removed.
  changedBy String      @map("changed_by")
  /// Nullable here and required at the application level when the status is rto, returned or
  /// cancelled. Neither Prisma nor a plain Postgres column can express a constraint that is
  /// conditional on another column's value, so the rule lives in the code that writes the row.
  reason    String?

  @@index([orderId])
  @@map("order_status_history")
}

model OrderLineItem {
  id              String  @id @default(uuid())
  orderId         String  @map("order_id")
  order           Order   @relation(fields: [orderId], references: [id])
  /// The P-code from data/products.json. Not a foreign key: the catalogue is not in this
  /// database and is not going to be. See ADR-040.
  productId       String  @map("product_id")
  productName     String  @map("product_name")
  productImage    String  @map("product_image")
  /// The recorded choice, as { "Letter": "A" }. Display and fulfilment only — no amount has
  /// ever read it. See ADR-019.
  selectedOptions Json?   @map("selected_options")
  quantity        Int
  /// What the customer was charged per unit, snapshotted from pricing.price at capture time.
  unitPrice       Decimal @map("unit_price") @db.Decimal(10, 2)
  /// What the unit cost the shop, snapshotted from pricing.cost at capture time. Margin data:
  /// it belongs to the admin dashboard and never to a shopper-facing response.
  unitCost        Decimal @map("unit_cost") @db.Decimal(10, 2)

  @@index([orderId])
  @@index([productId])
  @@map("order_line_items")
}

/// A buyer, keyed by phone because that is the one identifier a guest checkout always collects
/// and the one the owner already uses to recognise a repeat customer. There are still no
/// accounts and no login: this is a CRM record, not a credential.
model Customer {
  id               String   @id @default(uuid())
  phone            String   @unique
  name             String
  email            String?
  createdAt        DateTime @default(now()) @map("created_at")
  /// First-touch attribution, kept on the customer rather than only on the order so the
  /// campaign that won someone survives every later purchase. See ADR-039.
  firstUtmSource   String?  @map("first_utm_source")
  firstUtmMedium   String?  @map("first_utm_medium")
  firstUtmCampaign String?  @map("first_utm_campaign")
  orders           Order[]

  @@map("customers")
}

/// One logged-in browser. The cookie carries an opaque random token and nothing else; this
/// table holds the SHA-256 of that token, so a database dump yields no usable session. Deleting
/// a row logs that browser out immediately, which is the property a signed stateless cookie
/// cannot offer. See ADR-041.
///
/// There is no `Admin` model to reference. Admin credentials are `ADMIN_USERNAME`/
/// `ADMIN_PASSWORD` in the environment, not a database row — see ADR-061 — so `adminId` is a
/// plain string rather than a foreign key.
model AdminSession {
  id        String   @id @default(uuid())
  /// The SHA-256 of the cookie token, hex encoded. Unique because it is what a lookup keys on.
  tokenHash String   @unique @map("token_hash")
  /// Always `ADMIN_IDENTITY_ID` from lib/admin-auth.ts ("env-admin"). There is exactly one
  /// admin identity, so this names it rather than joining to a row that no longer exists.
  adminId   String   @map("admin_id")
  createdAt DateTime @default(now()) @map("created_at")
  /// Seven days after creation, set by the application rather than by a database default so
  /// the window is stated once, in lib/admin-session.ts, and read by the tests that prove it.
  expiresAt DateTime @map("expires_at")

  @@index([adminId])
  @@index([expiresAt])
  @@map("admin_sessions")
}
